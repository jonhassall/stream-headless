# Required
PAGE_URL=https://example.com/
RTMP_URL=rtmp://example.invalid/live/replace-with-your-stream-key

# VNC authentication supports 6-8 characters. Use noVNC only on a trusted LAN
# or behind your own TLS reverse proxy.
VNC_PASSWORD=changeMe

# Stream encoding
RESOLUTION=1280x720
FRAMERATE=30
VIDEO_BITRATE=3500k
# auto probes NVENC, then VAAPI, then falls back to libx264.
# Other accepted values: software, nvenc, vaapi
VIDEO_ENCODER=auto
# Used only when VIDEO_ENCODER=software or auto falls back to libx264.
# Faster presets reduce CPU usage at the cost of compression efficiency.
X264_PRESET=veryfast
AUDIO_ENABLED=true
AUDIO_BITRATE=128k

# noVNC host binding
CONTROL_BIND=0.0.0.0
CONTROL_PORT=6080

# Delay before retrying an interrupted RTMP connection
RTMP_RETRY_DELAY=5

# Restart Chromium after this many seconds to limit browser memory growth.
# Set to 0 to leave Chromium running indefinitely.
BROWSER_RESTART_INTERVAL_SECONDS=0
